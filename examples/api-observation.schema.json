{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: MPL-2.0. This schema describes a normalized wire event.",
  "title": "Guard API observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["timestamp", "api_route", "http_method", "status_code"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{6})?Z$"
    },
    "api_route": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^/(?:[A-Za-z0-9._~{}-]+/)*[A-Za-z0-9._~{}-]*$",
      "not": {
        "pattern": "/\\.{1,2}(?:/|$)"
      },
      "description": "Relative route path. Prefer templates for path segments containing dynamic identifiers."
    },
    "http_method": {
      "type": "string",
      "pattern": "^[A-Z]{1,16}$"
    },
    "status_code": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "request_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "response_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    }
  }
}
